# Copia este archivo como ".env" y ajusta los valores.
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Base de datos: sqlite (por defecto) o postgres
DB_ENGINE=sqlite
# DB_ENGINE=postgres
# DB_NAME=agroquiriquina
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_HOST=localhost
# DB_PORT=5432
